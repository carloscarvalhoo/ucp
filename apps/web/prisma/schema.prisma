generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model admin_sessions {
  id_hash     String      @id @db.Char(64)
  user_id     BigInt      @db.UnsignedBigInt
  expires_at  DateTime    @db.DateTime(0)
  created_at  DateTime    @default(now()) @db.Timestamp(0)
  admin_users admin_users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_sessions_ibfk_1")

  @@index([expires_at], map: "expires_at")
  @@index([user_id], map: "user_id")
}

model admin_users {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name              String              @db.VarChar(150)
  email             String              @unique(map: "email") @db.VarChar(254)
  password_hash     String              @db.VarChar(255)
  role              admin_users_role    @default(editor)
  active            Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamp(0)
  admin_sessions    admin_sessions[]
  audit_events      audit_events[]
  content_entries   content_entries[]
  content_revisions content_revisions[]
}

model audit_events {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     BigInt?      @db.UnsignedBigInt
  action      String       @db.VarChar(100)
  entity_type String?      @db.VarChar(50)
  entity_id   String?      @db.VarChar(100)
  details     Json?
  created_at  DateTime     @default(now()) @db.Timestamp(0)
  admin_users admin_users? @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_events_ibfk_1")

  @@index([user_id], map: "user_id")
}

model content_entries {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  kind              String                 @db.VarChar(50)
  slug              String                 @unique(map: "slug") @db.VarChar(500)
  title             String                 @db.VarChar(255)
  status            content_entries_status @default(draft)
  draft_data        Json
  published_data    Json?
  revision          Int                    @default(1) @db.UnsignedInt
  published_at      DateTime?              @db.DateTime(0)
  updated_by        BigInt?                @db.UnsignedBigInt
  updated_at        DateTime               @default(now()) @db.Timestamp(0)
  created_at        DateTime               @default(now()) @db.Timestamp(0)
  admin_users       admin_users?           @relation(fields: [updated_by], references: [id], onUpdate: NoAction, map: "content_entries_ibfk_1")
  content_revisions content_revisions[]

  @@index([kind, status], map: "kind")
  @@index([updated_by], map: "updated_by")
}

model content_revisions {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  entry_id        BigInt          @db.UnsignedBigInt
  revision        Int             @db.UnsignedInt
  data            Json
  author_id       BigInt?         @db.UnsignedBigInt
  created_at      DateTime        @default(now()) @db.Timestamp(0)
  content_entries content_entries @relation(fields: [entry_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "content_revisions_ibfk_1")
  admin_users     admin_users?    @relation(fields: [author_id], references: [id], onUpdate: NoAction, map: "content_revisions_ibfk_2")

  @@unique([entry_id, revision], map: "entry_id")
  @@index([author_id], map: "author_id")
}

model media_assets {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  storage_key   String   @db.VarChar(500)
  original_name String   @db.VarChar(255)
  mime_type     String   @db.VarChar(100)
  byte_size     BigInt   @db.UnsignedBigInt
  alt_text      String   @default("") @db.VarChar(500)
  credit        String?  @db.Text
  source_url    String?  @db.Text
  illustrative  Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp(0)
}

model navigation_menus {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  location        String   @unique(map: "location") @db.VarChar(50)
  draft_items     Json
  published_items Json?
  updated_at      DateTime @default(now()) @db.Timestamp(0)
}

model schema_migrations {
  version    String   @id @db.VarChar(100)
  applied_at DateTime @default(now()) @db.Timestamp(0)
}

model site_settings {
  setting_key     String   @id @db.VarChar(100)
  draft_value     Json
  published_value Json?
  updated_at      DateTime @default(now()) @db.Timestamp(0)
}

enum content_entries_status {
  draft
  published
  archived
}

enum admin_users_role {
  administrator
  editor
}
